# Copy this file to .env and fill in your key. .env is gitignored.
OPENROUTER_API_KEY=
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Optional: LangSmith tracing (free Developer plan). Set to true and add your key to record every request.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=citerag

# Deployment settings (set these in the host's environment variables page, not here).
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# QUESTIONS_PER_HOUR=20
# QUESTIONS_PER_DAY=300
